{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WSS: server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../../build/bonus/networking/lesson-20-wss/server",
            "cwd": "${fileDirname}",
            "preLaunchTask": "Networking: Build server",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "externalConsole": false,
            "miDebuggerPath": "/usr/bin/gdb",
            "windows": {
                "program": "${workspaceFolder}/../../../build/bonus/networking/lesson-20-wss/server.exe",
                "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
            },
            "args": [
                "42020",
                "../../../build/networking-tls/cert.pem",
                "../../../build/networking-tls/key.pem"
            ]
        },
        {
            "name": "WSS: client",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../../build/bonus/networking/lesson-20-wss/client",
            "cwd": "${fileDirname}",
            "preLaunchTask": "Networking: Build client",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "externalConsole": false,
            "miDebuggerPath": "/usr/bin/gdb",
            "windows": {
                "program": "${workspaceFolder}/../../../build/bonus/networking/lesson-20-wss/client.exe",
                "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
            },
            "args": [
                "42020",
                "../../../build/networking-tls/cert.pem"
            ]
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/../../../scripts/build-linux.sh",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/../../../scripts/build-windows.sh",
                    "${file}"
                ]
            }
        },
        {
            "label": "C/C++: Update IntelliSense",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/../../../scripts/generate-compile-commands.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/../../../scripts/generate-compile-commands.sh"
                ]
            }
        },
        {
            "label": "C/C++: Run (No Build)",
            "type": "process",
            "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "windows": {
                "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/${fileBasenameNoExtension}.exe"
            }
        },
        {
            "label": "Networking: Build server",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/../../../scripts/build-linux.sh",
                "${workspaceFolder}/server.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/../../../scripts/build-windows.sh",
                    "${workspaceFolder}/server.cpp"
                ]
            }
        },
        {
            "label": "Networking: Run server",
            "type": "process",
            "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/server",
            "dependsOn": "Networking: Build server",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "windows": {
                "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/server.exe"
            }
        },
        {
            "label": "Networking: Build client",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/../../../scripts/build-linux.sh",
                "${workspaceFolder}/client.cpp"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/../../../scripts/build-windows.sh",
                    "${workspaceFolder}/client.cpp"
                ]
            }
        },
        {
            "label": "Networking: Run client",
            "type": "process",
            "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/client",
            "dependsOn": "Networking: Build client",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "windows": {
                "command": "${workspaceFolder}/../../../build/bonus/networking/lesson-08-rest-api/client.exe"
            }
        }
    ]
}

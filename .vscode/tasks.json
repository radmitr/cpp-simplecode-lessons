{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build and Run",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "-c",
                "/bin/bash \"$1\" \"$2\" && exec \"$3\"",
                "build-and-run",
                "${workspaceFolder}/scripts/build-linux.sh",
                "${file}",
                "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "-c",
                    "C:/msys64/usr/bin/bash.exe \"$1\" \"$2\" && exec \"$3\"",
                    "build-and-run",
                    "${workspaceFolder}/scripts/build-windows.sh",
                    "${file}",
                    "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}.exe"
                ]
            }
        },
        {
            "label": "C/C++: g++ build active file",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/scripts/build-linux.sh",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/scripts/build-windows.sh",
                    "${file}"
                ]
            }
        },
        {
            "label": "C/C++: Run (No Build)",
            "type": "process",
            "command": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}.exe"
            }
        }
    ]
}

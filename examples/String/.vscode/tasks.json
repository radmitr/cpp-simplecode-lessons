{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build and Run",
            "type": "shell",
            "command": "g++ -fdiagnostics-color=always -O0 -g -Wall -Wextra -Wpedantic \"${file}\" \"${fileDirname}/String.cpp\" -o \"${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}.exe\" && \"${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}.exe\"",
            "options": {
                "shell": {
                    "executable": "C:/msys64/usr/bin/bash.exe",
                    "args": ["-c"]
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "linux": {
                "command": "/usr/bin/g++ -fdiagnostics-color=always -std=c++17 -O0 -g -Wall -Wextra -Wpedantic -pthread \"${file}\" \"${fileDirname}/String.cpp\" -o \"${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}\" && \"${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}\"",
                "options": {
                    "cwd": "${fileDirname}",
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            },
            "dependsOn": "C/C++: Create build directory"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-O0",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "${file}",
                "${fileDirname}/String.cpp",
                "-o",
                "${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.",
            "linux": {
                "command": "/usr/bin/g++",
                "args": [
                    "-fdiagnostics-color=always",
                    "-std=c++17",
                    "-O0",
                    "-g",
                    "-Wall",
                    "-Wextra",
                    "-Wpedantic",
                    "-pthread",
                    "${file}",
                    "${fileDirname}/String.cpp",
                    "-o",
                    "${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}"
                ],
                "options": {
                    "cwd": "${fileDirname}"
                }
            },
            "dependsOn": "C/C++: Create build directory"
        },
        {
            "label": "C/C++: Run (No Build)",
            "type": "process",
            "command": "${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "linux": {
                "command": "${workspaceFolder}/../../build/examples/String/${fileBasenameNoExtension}"
            }
        },
        {
            "label": "C/C++: Create build directory",
            "type": "process",
            "command": "C:/msys64/usr/bin/mkdir.exe",
            "args": [
                "-p",
                "--",
                "${workspaceFolder}/../../build/examples/String"
            ],
            "linux": {
                "command": "/bin/mkdir"
            },
            "problemMatcher": [],
            "hide": true
        }
    ]
}

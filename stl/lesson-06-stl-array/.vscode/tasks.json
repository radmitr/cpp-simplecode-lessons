{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: Build",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/../../scripts/build-linux.sh",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "${workspaceFolder}/../../scripts/build-windows.sh",
                    "${file}"
                ]
            }
        },
        {
            "label": "C/C++: Run (No Build)",
            "type": "process",
            "command": "${workspaceFolder}/../../build/stl/lesson-06-stl-array/${fileBasenameNoExtension}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "windows": {
                "command": "${workspaceFolder}/../../build/stl/lesson-06-stl-array/${fileBasenameNoExtension}.exe"
            }
        }
    ]
}

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Run and Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../build/io/lesson-119-stream-io-operator-overloading/${fileBasenameNoExtension}",
            "cwd": "${fileDirname}",
            "preLaunchTask": "C/C++: Build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "externalConsole": false,
            "miDebuggerPath": "/usr/bin/gdb",
            "windows": {
                "program": "${workspaceFolder}/../../build/io/lesson-119-stream-io-operator-overloading/${fileBasenameNoExtension}.exe",
                "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
            }
        }
    ]
}

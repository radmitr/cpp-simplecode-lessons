# Compiled programs and object/debug files
*.exe
*.out
*.o
*.obj
*.pdb
*.ilk

# Shared build output at the repository root
/build/

# Private notes, prompts, temporary files and local service data
/.local/

# Data generated by file I/O lessons
/io/lesson-117-serialize-objects-to-file/point.dat
/io/lesson-118-file-io-fstream/myFile.txt_
/io/bonus/18-portable-binary/point-v1.bin

# Keep only shared build/debug and IntelliSense configs, even if a global ignore excludes .vscode
!**/.vscode/
**/.vscode/*
!**/.vscode/tasks.json
!**/.vscode/launch.json
!/.vscode/c_cpp_properties.json

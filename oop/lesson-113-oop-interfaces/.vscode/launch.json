{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Run and Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../../build/oop/lesson-113-oop-interfaces/${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "preLaunchTask": "C/C++: g++.exe build active file",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "linux": {
                "program": "${workspaceFolder}/../../build/oop/lesson-113-oop-interfaces/${fileBasenameNoExtension}",
                "miDebuggerPath": "/usr/bin/gdb",
                "externalConsole": false
            }
        }
    ]
}
